# 黎明缠论(lmcl)定制配置 —— 由 main/Kconfig.projbuild 用 rsource 引入。
# 单独成文件,使上游 Kconfig.projbuild 只留一行 hook,降低跟随上游时的冲突面。
# 仅放「我方新增」的配置;改上游既有配置(如 USE_DEVICE_AEC)仍在 Kconfig.projbuild 就地改。

config DEVICE_BOOTSTRAP_URL
    string "Self-hosted device Bootstrap URL"
    default "https://api.lmcl.xyz/grpc-gateway/CompanionDeviceService/Bootstrap"
    help
        When set, the websocket protocol will POST {sn, secret} to this URL,
        read data.deviceToken and data.config.endpoints.websocket from the
        response, then connect to the websocket endpoint with ?token=.
        This follows the self-hosted server device access contract.

config DEVICE_FACTORY_ORG_ID
    string "Development factory orgId"
    default "858868370294965248"
    help
        Development fallback for devices without a factory-programmed NVS
        identity/orgId. Production tooling should pre-program identity/orgId,
        identity/sn, and identity/secret in NVS; NVS values take precedence.

config DEVICE_FACTORY_SECRET
    string "Development factory secret (legacy)"
    default ""
    help
        Legacy development fallback. The firmware reads the per-device factory
        secret from NVS namespace "identity" (key "secret") — see device_identity.cc
        (出厂预登记,不再首启自生成). This Kconfig value is NOT read by the firmware
        runtime; kept only for reference / manufacturing tooling.

config DEVICE_MODEL_CODE
    string "Device Model Code (deviceModelCode)"
    default "lmcl-box-v2-cam" if BOARD_TYPE_LMCL_BOX_V2_CAM
    default "lmcl-box-v1"
    help
        Default model code reported in the status frame for the self-hosted server.

config LMCL_SN_PREFIX
    string "LMCL Serial Number prefix"
    default "lmcl-cam-" if BOARD_TYPE_LMCL_BOX_V2_CAM
    default "lmcl-"
    help
        LMCL sn 前缀约定(如 "lmcl-")。产线工装生成出厂 (sn, secret) 烧入 NVS "identity"
        时用此前缀。固件运行时**不读**它——device_identity 只读出厂预置 sn(不再首启自生成)。

menu "Alarm Settings"
    config ALARM_RING_INTERVAL_SECONDS
        int "Ring interval between successive alarm sounds (seconds)"
        default 8
        range 3 60
        help
            每次闹钟铃声播放完后,等待多少秒再播放下一遍。

    config ALARM_GAIN_PERCENT
        int "Alarm playback gain (%)"
        default 180
        range 50 250
        help
            闹钟音量放大系数(百分比)。100=原始音量,180=放大80%,50=减小50%。

    config ALARM_NOTIFICATION_DURATION_MS
        int "Screen notification display duration (ms)"
        default 8000
        range 1000 30000
        help
            每次响铃时屏幕通知消息的显示持续时长(毫秒)。
endmenu

config USE_REALTIME_CHAT
    bool "LMCL realtime interruptible chat"
    default y
    depends on BOARD_TYPE_LMCL_BOX_V2_CAM && USE_DEVICE_AEC
    help
        LMCL-specific low-latency conversation mode. It is kept in Kconfig.lmcl
        so upstream Xiaozhi board defaults stay unchanged.

menu "LMCL Vision Uplink"
    config LMCL_VISION_UPLINK_ENABLED
        bool "Enable /agent/v1 JPEG vision uplink"
        default y
        depends on !IDF_TARGET_ESP32
        help
            When the board has a camera and the Companion websocket is open,
            periodically capture a JPEG frame and send it as binary frame
            [0x02][JPEG] on /agent/v1. The server decides at model runtime
            whether the frame is used.

    config LMCL_VISION_FRAME_INTERVAL_MS
        int "Vision frame interval (ms)"
        default 1000
        range 333 10000
        depends on LMCL_VISION_UPLINK_ENABLED
        help
            Minimum delay between captured JPEG frames. Default is 1 FPS.

    config LMCL_VISION_JPEG_QUALITY
        int "Vision JPEG quality"
        default 70
        range 30 95
        depends on LMCL_VISION_UPLINK_ENABLED
        help
            JPEG quality used for vision uplink frames when the camera source
            is not already JPEG.

    config LMCL_VISION_MAX_FRAME_BYTES
        int "Vision max frame bytes"
        default 524288
        range 32768 1048576
        depends on LMCL_VISION_UPLINK_ENABLED
        help
            Maximum JPEG frame size sent to /agent/v1. The backend currently
            accepts up to 512 KiB per frame.
endmenu
