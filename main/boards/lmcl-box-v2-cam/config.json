{
    "target": "esp32s3",
    "builds": [
        {
            "name": "lmcl-box-v2-cam",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_LMCL_BOX_V2_CAM=y",
                "CONFIG_DEVICE_MODEL_CODE=\"lmcl-box-v2-cam\"",
                "CONFIG_LMCL_SN_PREFIX=\"LMCL\"",
                "CONFIG_USE_DEVICE_AEC=y",
                "# CONFIG_USE_AFE_WAKE_WORD is not set",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"xiao le xiao le\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"小乐小乐\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "# CONFIG_SEND_WAKE_WORD_DATA is not set",
                "# CONFIG_SR_MN_CN_NONE is not set",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=48",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32",
                "CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=n",
                "CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y",
                "CONFIG_LV_USE_FONT_COMPRESSED=y",
                "CONFIG_LV_USE_FONT_PLACEHOLDER=y",
                "# CONFIG_USE_DEFAULT_MESSAGE_STYLE is not set",
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=y"
            ]
        }
    ]
}
